{
  "name": "gyomu",
  "version": "0.0.1",
  "description": "TypeScript Monorepo library used in gyomu",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow@1.2.1 pnpm",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build:types": "tsc -b",
    "build": "turbo run build",
    "build:local": "pnpm run build:types",
    "build:all": "pnpm run build ",
    "build:clean": "tsc -b --clean && pnpm run build:all",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:ci:coverage": "turbo run test --filter=\"...[origin/main]\" -- --coverage",
    "coverage:merge": "istanbul-merge --out coverage/coverage-final.json packages/*/coverage/coverage-final.json",
    "coverage:report": "nyc report --reporter=html --reporter=text-summary --temp-dir coverage",
    "coverage:all": "pnpm test:coverage && pnpm coverage:merge && pnpm coverage:report",
    "coverage:ci:all": "pnpm test:ci:coverage && pnpm coverage:merge && pnpm coverage:report",
    "dep:check": "knip",
    "check:sync:version": "pnpm syncpack lint"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm",
    "pnpm": ">=7",
    "yarn": "use pnpm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "istanbul-merge": "^2.0.0",
    "knip": "^6.10.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.1.3",
    "syncpack": "^14.3.1",
    "tsup": "^8.5.1",
    "turbo": "^2.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    }
  }
}
