{
  "name": "gyomu",
  "version": "0.0.1",
  "description": "TypeScript Monorepo library used in gyomu",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow@1.2.1 pnpm",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint packages/**src/**/*.{ts,d.ts}",
    "format": "prettier --write packages/**/src/**/*.ts",
    "build:types": "tsc -b",
    "build": "pnpm run build:types",
    "build:all": "pnpm run build ",
    "build:clean": "tsc -b --clean && pnpm run build:all",
    "format:check": "pnpm format --check --debug-check"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm",
    "pnpm": ">=7",
    "yarn": "use pnpm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "syncpack": "^14.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^3.1.0"
  }
}
