{
  "name": "gyomu",
  "version": "0.0.1",
  "description": "TypeScript Monorepo library used in gyomu",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow@1.2.1 pnpm",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint packages/**src/**/*.{ts,d.ts}",
    "format": "prettier --write packages/**/src/**/*.ts",
    "build:types": "tsc -b",
    "build": "pnpm run build:types",
    "build:all": "pnpm run build ",
    "build:clean": "tsc -b --clean && pnpm run build:all",
    "format:check": "pnpm format --check --debug-check",
    "test:coverage": "pnpm -r test:coverage",
    "test:ci:coverage": "pnpm -r --filter \"...[origin/main]\" test:ci:coverage",
    "coverage:merge": "istanbul-merge --out coverage/coverage-final.json packages/*/coverage/coverage-final.json",
    "coverage:report": "nyc report --reporter=html --reporter=text-summary --temp-dir coverage",
    "coverage:all": "pnpm test:coverage && pnpm coverage:merge && pnpm coverage:report",
    "coverage:ci:all": "pnpm test:ci:coverage && pnpm coverage:merge && pnpm coverage:report",
    "dep:check": "knip"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": "use pnpm",
    "pnpm": ">=7",
    "yarn": "use pnpm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "istanbul-merge": "^2.0.0",
    "knip": "^6.10.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "syncpack": "^14.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  }
}
