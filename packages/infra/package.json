{
  "name": "@gyomu/infra",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript.git",
    "directory": "packages/infra"
  },
  "bugs": {
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "@test": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "@test:coverage": "node --env-file=.env ../../node_modules/vitest/vitest.mjs --config vitest.coverage.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "@test:ci:coverage": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "build": "tsc -p tsconfig.build.json",
    "build:ci": "pnpm run clean && pnpm run build",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "schema-gen": "kysely-codegen --dialect mssql --env-file=.env --config-file=.kysely-codegenrc.json",
    "sit": "bunx vitest --config vitest.sit.config.ts --typecheck.tsconfig ./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@tediousjs/connection-string": "^1.1.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "catalog:",
    "@types/ssh2": "^1.15.5",
    "@types/tar-stream": "^3.1.4",
    "@types/xml2js": "^0.4.14",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "dotenv": "^17.3.1",
    "globals": "^17.6.0",
    "kysely": "^0.29.4",
    "kysely-codegen": "^0.20.0",
    "undici": "^8.10.0"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@gyomu/schema": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "basic-ftp": "^6.0.0",
    "csv": "^6.5.1",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.7.0",
    "date-fns": "catalog:",
    "effect": "catalog:",
    "fast-glob": "^3.3.3",
    "html-entities": "^2.6.0",
    "jose": "^6.2.3",
    "jsdom": "catalog:",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.13",
    "tar-stream": "^3.2.0",
    "tarn": "^3.0.2",
    "tedious": "^20.0.0",
    "uuidv7": "^1.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  }
}
