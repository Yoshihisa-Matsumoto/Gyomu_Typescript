{
  "name": "@gyomu/ai-react",
  "version": "0.2.4-beta.2",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "build:ci": "pnpm run clean && pnpm run build",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "schema-gen": "kysely-codegen --dialect mssql --env-file=.env --config-file=.kysely-codegenrc.json",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/react": "^3.0.186",
    "@gyomu/schema": "workspace:*",
    "@gyomu/ui-core": "workspace:*",
    "ai": "^6.0.182",
    "effect": "4.0.0-beta.57",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19"
  }
}
