{
  "name": "@gyomu/ai-compiler",
  "version": "1.1.3",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript.git",
    "directory": "packages/ai-compiler"
  },
  "bugs": {
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript/issues"
  },
  "exports": {
    "./jsdoc-update": {
      "import": "./dist/pipelines/jsdoc-update/index.js",
      "types": "./dist/pipelines/jsdoc-update/index.d.ts"
    },
    "./file-summary": {
      "import": "./dist/pipelines/file-summary/index.js",
      "types": "./dist/pipelines/file-summary/index.d.ts"
    },
    "./directory-concept": {
      "import": "./dist/pipelines/directory-concept/index.js",
      "types": "./dist/pipelines/directory-concept/index.d.ts"
    },
    "./package-concept": {
      "import": "./dist/pipelines/package-concept/index.js",
      "types": "./dist/pipelines/package-concept/index.d.ts"
    },
    "./document": {
      "import": "./dist/pipelines/document/index.js",
      "types": "./dist/pipelines/document/index.d.ts"
    },
    "./llm-context": {
      "import": "./dist/pipelines/llm-context/index.js",
      "types": "./dist/pipelines/llm-context/index.d.ts"
    },
    "./readme": {
      "import": "./dist/pipelines/readme/index.js",
      "types": "./dist/pipelines/readme/index.d.ts"
    },
    "./translation": {
      "import": "./dist/pipelines/translation/index.js",
      "types": "./dist/pipelines/translation/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "@test:coverage": "vitest --config vitest.coverage.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "@test:ci:coverage": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc && node scripts/copy-prompts.js",
    "build:ci": "pnpm run clean && pnpm run build",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "@gyomu/ai": "workspace:^",
    "@gyomu/facts": "workspace:^",
    "@gyomu/infra": "workspace:^",
    "@gyomu/schema": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "dotenv": "catalog:"
  }
}
