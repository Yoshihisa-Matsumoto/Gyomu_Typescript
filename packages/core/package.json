{
  "name": "@gyomu/core",
  "version": "0.2.1",
  "description": "",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./lib/*.js",
      "types": "./lib/*.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./lib && rimraf ./coverage .tsbuildinfo",
    "test": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "test:coverage": "vitest --config vitest.coverage.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "@@postgre:setup": "prisma generate --schema ./prisma/schema.prisma.postgre",
    "@@sit:docker": "docker-compose -f ./test-docker/docker-compose.yml up -d",
    "@@sit:docker_down": "docker-compose -f ./test-docker/docker-compose.yml down",
    "schema-gen": "kysely-codegen --dialect mssql --env-file=.env --config-file=.kysely-codegenrc.json",
    "@sit": "pnpm run postgre:setup && pnpm run sit:docker && dotenv -e .env.sit -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json && pnpm run sit:docker_down",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "index.js",
    "lib",
    "!**/__tests__",
    "!**/__sit__"
  ],
  "devDependencies": {
    "@tediousjs/connection-string": "^1.0.0",
    "@types/fs-extra": "^11.0.3",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "@types/ssh2": "^1.15.5",
    "@types/tar": "^7.0.87",
    "@types/tar-stream": "^3.1.4",
    "@types/tmp": "^0.2.6",
    "@types/xlsx": "^0.0.35",
    "@types/xml2js": "^0.4.14",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "dotenv-cli": "^11.0.0",
    "globals": "^17.1.0",
    "jsdom": "^29.0.2",
    "knip": "^6.4.1",
    "kysely": "^0.28.16",
    "kysely-codegen": "^0.20.0",
    "tmp": "^0.2.5",
    "undici": "^8.1.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.42",
    "@google/genai": "^1.50.1",
    "@gyomu/shared": "workspace:*",
    "@mastra/core": "^1.28.0",
    "basic-ftp": "^5.3.0",
    "csv": "^6.4.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "effect": "4.0.0-beta.42",
    "fs-extra": "^11.3.3",
    "html-entities": "^2.6.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "pg": "^8.17.2",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.6",
    "tar-stream": "^3.1.8",
    "tarn": "^3.0.2",
    "tedious": "^19.2.1",
    "uuidv7": "^1.2.1",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml2js": "^0.6.2",
    "yauzl": "^3.2.1",
    "yazl": "^3.3.1"
  }
}
