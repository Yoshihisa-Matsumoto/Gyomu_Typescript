{
  "name": "@gyomu/concept",
  "version": "1.1.0",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript.git",
    "directory": "packages/concept"
  },
  "bugs": {
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./directory": {
      "import": "./dist/directory/index.js",
      "types": "./dist/directory/index.d.ts"
    },
    "./llm-context": {
      "import": "./dist/llm-context/index.js",
      "types": "./dist/llm-context/index.d.ts"
    },
    "./package": {
      "import": "./dist/package/index.js",
      "types": "./dist/package/index.d.ts"
    },
    "./readme": {
      "import": "./dist/readme/index.js",
      "types": "./dist/readme/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "build:ci": "pnpm run clean && pnpm run build",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "@gyomu/ai": "workspace:^",
    "@gyomu/ai-compiler": "workspace:^",
    "@gyomu/facts": "workspace:^",
    "@gyomu/infra": "workspace:^",
    "@gyomu/schema": "workspace:^",
    "@gyomu/ts-analysis": "workspace:^",
    "effect": "catalog:"
  }
}
