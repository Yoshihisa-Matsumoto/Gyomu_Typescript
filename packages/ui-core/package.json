{
  "name": "@gyomu/ui-core",
  "version": "0.2.1",
  "description": "",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dsl": {
      "import": "./dist/dsl/index.js",
      "types": "./dist/dsl/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "build:ci": "pnpm run clean && pnpm run build",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "index.js",
    "!**/__tests__",
    "!**/__sit__"
  ],
  "dependencies": {
    "@gyomu/schema": "workspace:*",
    "effect": "4.0.0-beta.57",
    "react": "19.2.4"
  }
}
