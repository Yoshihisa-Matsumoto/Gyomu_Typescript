{
  "name": "@gyomu/ui-core",
  "version": "1.1.3",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript.git",
    "directory": "packages/ui-core"
  },
  "bugs": {
    "url": "https://github.com/Yoshihisa-Matsumoto/Gyomu_Typescript/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dsl": {
      "import": "./dist/dsl/index.js",
      "types": "./dist/dsl/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "test": "bunx vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "build:ci": "pnpm run clean && pnpm run build",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "@gyomu/schema": "workspace:^",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}
