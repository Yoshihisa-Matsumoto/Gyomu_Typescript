{
  "name": "@gyomu/ai",
  "version": "0.2.1",
  "description": "",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./lib/*.js",
      "types": "./lib/*.d.ts"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "rimraf ./lib && rimraf ./coverage .tsbuildinfo",
    "test": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json ",
    "test:coverage": "vitest --config vitest.coverage.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "test:ci:coverage": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json --coverage",
    "start": "pnpm run build:live",
    "watch": "tsc -w",
    "build": "tsc",
    "build:ci": "pnpm run clean && pnpm run build",
    "Sprepare": "pnpm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "schema-gen": "kysely-codegen --dialect mssql --env-file=.env --config-file=.kysely-codegenrc.json",
    "sit": "dotenv -e .env -- vitest --config=./vitest.sit.config.ts --typecheck.tsconfig=./tsconfig.vitest.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "index.js",
    "lib",
    "!**/__tests__",
    "!**/__sit__"
  ],
  "devDependencies": {},
  "dependencies": {
    "@gyomu/core": "workspace:*",
    "@gyomu/shared": "workspace:*",
    "@gyomu/infra": "workspace:*",
    "@mastra/core": "^1.28.0",
    "effect": "4.0.0-beta.59"
  }
}
