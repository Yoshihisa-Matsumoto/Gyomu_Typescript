      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:ci": "pnpm run clean && pnpm run build",
    "clean": "rimraf ./dist ./coverage ./.turbo ./.tsbuildinfo",
    "type-check": "tsc --project tsconfig.typecheck.json",
    "test": "vitest --config vitest.config.ts --typecheck.tsconfig ./tsconfig.vitest.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
